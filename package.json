{
  "name": "@riddance/aws-host",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "riddance",
    "serverless",
    "environment",
    "devops",
    "aws",
    "opinionated"
  ],
  "files": [
    "*.js",
    "lib/*.js"
  ],
  "exports": {
    "./context": "./context.js",
    "./http": "./http.js",
    "./timer": "./timer.js",
    "./event": "./event.js"
  },
  "dependencies": {
    "@riddance/service": "0.3.0",
    "@riddance/host": "0.3.0",
    "@riddance/fetch": "0.1.4",
    "@smithy/signature-v4": "5.4.3"
  },
  "devDependencies": {
    "@riddance/env": "0.10.0"
  },
  "scripts": {
    "start": "riddance-watch",
    "prepack": "riddance-build",
    "prepublishOnly": "riddance-prepublish",
    "postpublish": "riddance-sync"
  }
}
